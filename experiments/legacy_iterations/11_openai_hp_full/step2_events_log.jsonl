{"story": "Harry Potter", "variant": "modified", "chapter": 1, "chapter_file": "001.txt", "event": {"id": "e1", "type": "talk", "agent": "aunt_petunia", "patient": "harry_potter", "location": "number_four", "after": null, "social_action_type": null, "source_text": "\u201cUp! Get up! Now!\u201d", "event_time": 0, "event_index": 0, "global_id": "e1", "chapter": 1}}
{"story": "Harry Potter", "variant": "modified", "chapter": 1, "chapter_file": "001.txt", "event": {"id": "e2", "type": "think", "agent": "harry_potter", "patient": null, "location": "cupboard_under_the_stairs", "after": "e1", "social_action_type": null, "source_text": "He rolled onto his back and tried to remember the dream he had been having.", "event_time": 1, "event_index": 1, "global_id": "e2", "chapter": 1}}
{"story": "Harry Potter", "variant": "modified", "chapter": 1, "chapter_file": "001.txt", "event": {"id": "e3", "type": "talk", "agent": "aunt_petunia", "patient": "harry_potter", "location": "number_four", "after": "e2", "social_action_type": null, "source_text": "\u201cAre you up yet?\u201d she demanded.", "event_time": 2, "event_index": 2, "global_id": "e3", "chapter": 1}}
{"story": "Harry Potter", "variant": "modified", "chapter": 1, "chapter_file": "001.txt", "event": {"id": "e4", "type": "talk", "agent": "harry_potter", "patient": "aunt_petunia", "location": "number_four", "after": "e3", "social_action_type": null, "source_text": "\u201cNearly,\u201d said Harry.", "event_time": 3, "event_index": 3, "global_id": "e4", "chapter": 1}}
{"story": "Harry Potter", "variant": "modified", "chapter": 1, "chapter_file": "001.txt", "event": {"id": "e5", "type": "talk", "agent": "aunt_petunia", "patient": "harry_potter", "location": "number_four", "after": "e4", "social_action_type": null, "source_text": "\u201cWell, get a move on, I want you to look after the bacon.", "event_time": 4, "event_index": 4, "global_id": "e5", "chapter": 1}}
{"story": "Harry Potter", "variant": "modified", "chapter": 1, "chapter_file": "001.txt", "event": {"id": "e6", "type": "talk", "agent": "uncle_vernon", "patient": "harry_potter", "location": "kitchen", "after": null, "social_action_type": null, "source_text": "\u201cComb your hair!\u201d he barked, by way of a morning greeting.", "event_time": 5, "event_index": 5, "global_id": "e6", "chapter": 1}}
{"story": "Harry Potter", "variant": "modified", "chapter": 1, "chapter_file": "001.txt", "event": {"id": "e7", "type": "talk", "agent": "dudley_dursley", "patient": "aunt_petunia", "location": "kitchen", "after": null, "social_action_type": null, "source_text": "\u201cThirty-six,\u201d he said, looking up at his mother and father.", "event_time": 6, "event_index": 6, "global_id": "e7", "chapter": 1}}
{"story": "Harry Potter", "variant": "modified", "chapter": 1, "chapter_file": "001.txt", "event": {"id": "e8", "type": "talk", "agent": "aunt_petunia", "patient": "dudley_dursley", "location": "kitchen", "after": "e7", "social_action_type": null, "source_text": "\u201cDarling, you haven\u2019t counted Auntie Marge\u2019s present, see, it\u2019s here under this big one from Mommy and Daddy.\u201d", "event_time": 7, "event_index": 7, "global_id": "e8", "chapter": 1}}
{"story": "Harry Potter", "variant": "modified", "chapter": 1, "chapter_file": "001.txt", "event": {"id": "e9", "type": "talk", "agent": "dudley_dursley", "patient": "aunt_petunia", "location": "kitchen", "after": "e8", "social_action_type": null, "source_text": "\u201cAll right, thirty-seven then,\u201d said Dudley, going pale green in the face.", "event_time": 8, "event_index": 8, "global_id": "e9", "chapter": 1}}
{"story": "Harry Potter", "variant": "modified", "chapter": 1, "chapter_file": "001.txt", "event": {"id": "e10", "type": "talk", "agent": "aunt_petunia", "patient": "dudley_dursley", "location": "kitchen", "after": "e9", "social_action_type": null, "source_text": "\u201cAnd we\u2019ll buy you another two presents while we\u2019re out today.", "event_time": 9, "event_index": 9, "global_id": "e10", "chapter": 1}}
{"story": "Harry Potter", "variant": "modified", "chapter": 1, "chapter_file": "001.txt", "event": {"id": "e11", "type": "talk", "agent": "uncle_vernon", "patient": "dudley_dursley", "location": "kitchen", "after": "e10", "social_action_type": null, "source_text": "\u201cLittle tyke wants his money\u2019s worth, just like his father.", "event_time": 10, "event_index": 10, "global_id": "e11", "chapter": 1}}
{"story": "Harry Potter", "variant": "modified", "chapter": 1, "chapter_file": "001.txt", "event": {"id": "e12", "type": "talk", "agent": "aunt_petunia", "patient": "uncle_vernon", "location": "kitchen", "after": "e11", "social_action_type": null, "source_text": "\u201cBad news, Vernon,\u201d she said. \u201cMrs. Figg\u2019s broken her leg.", "event_time": 11, "event_index": 11, "global_id": "e12", "chapter": 1}}
{"story": "Harry Potter", "variant": "modified", "chapter": 1, "chapter_file": "001.txt", "event": {"id": "e13", "type": "learn", "agent": "harry_potter", "fact": "mrs_figg_broken_leg", "source": null, "location": "kitchen", "after": "e12", "source_text": "Harry\u2019s heart gave a leap.", "event_time": 12, "event_index": 12, "global_id": "e13", "chapter": 1}}
{"story": "Harry Potter", "variant": "modified", "chapter": 1, "chapter_file": "001.txt", "event": {"id": "e14", "type": "talk", "agent": "aunt_petunia", "patient": "uncle_vernon", "location": "kitchen", "after": "e13", "social_action_type": null, "source_text": "\u201cNow what?\u201d said Aunt Petunia, looking furiously at Harry.", "event_time": 13, "event_index": 13, "global_id": "e14", "chapter": 1}}
{"story": "Harry Potter", "variant": "modified", "chapter": 1, "chapter_file": "001.txt", "event": {"id": "e15", "type": "talk", "agent": "uncle_vernon", "patient": "aunt_petunia", "location": "kitchen", "after": "e14", "social_action_type": null, "source_text": "\u201cWe could phone Marge,\u201d Uncle Vernon suggested.", "event_time": 14, "event_index": 14, "global_id": "e15", "chapter": 1}}
{"story": "Harry Potter", "variant": "modified", "chapter": 1, "chapter_file": "001.txt", "event": {"id": "e16", "type": "talk", "agent": "aunt_petunia", "patient": "uncle_vernon", "location": "kitchen", "after": "e15", "social_action_type": null, "source_text": "\u201cDon\u2019t be silly, Vernon, she hates the boy.", "event_time": 15, "event_index": 15, "global_id": "e16", "chapter": 1}}
{"story": "Harry Potter", "variant": "modified", "chapter": 1, "chapter_file": "001.txt", "event": {"id": "e17", "type": "talk", "agent": "harry_potter", "patient": "aunt_petunia", "location": "kitchen", "after": "e16", "social_action_type": null, "source_text": "\u201cYou could just leave me here,\u201d Harry put in hopefully.", "event_time": 16, "event_index": 16, "global_id": "e17", "chapter": 1}}
{"story": "Harry Potter", "variant": "modified", "chapter": 1, "chapter_file": "001.txt", "event": {"id": "e18", "type": "talk", "agent": "aunt_petunia", "patient": "harry_potter", "location": "kitchen", "after": "e17", "social_action_type": null, "source_text": "\u201cAnd come back and find the house in ruins?\u201d she snarled.", "event_time": 17, "event_index": 17, "global_id": "e18", "chapter": 1}}
