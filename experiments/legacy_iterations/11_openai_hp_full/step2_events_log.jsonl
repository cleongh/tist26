{"story": "Harry Potter", "variant": "modified", "chapter": 1, "chapter_file": "001.txt", "event": {"id": "e20", "type": "talk", "agent": "uncle_vernon", "patient": "aunt_petunia", "location": "kitchen", "after": "e19", "social_action_type": null, "source_text": "\u201cThat car\u2019s new, he\u2019s not sitting in it alone\u2026.\u201d", "event_time": 19, "event_index": 19, "global_id": "e20", "chapter": 1}}
