% =============================================================================
%
%    NARRATIVE CONSISTENCY CHECKER - ASP Rules
%    ==========================================
%
%    This file contains Answer Set Programming (ASP) rules for detecting
%    logical inconsistencies in narrative texts. It is designed to be used
%    with the Clingo solver and works in conjunction with facts generated
%    by the json_to_asp.py converter.
%
%    IMPORTANT: This file is NOT generated by an LLM. It is a fixed,
%    quality-assured set of rules that have been carefully designed to
%    avoid common ASP pitfalls (unsafe variables, grounding issues, etc.)
%
% =============================================================================
%
%    HOW THIS FILE WORKS
%    -------------------
%
%    1. The story is first converted to structured JSON by an LLM
%    2. json_to_asp.py converts that JSON to ASP facts (e.g., character(hansel).)
%    3. Those facts are loaded together with THIS file into Clingo
%    4. Clingo computes all valid "answer sets" (models)
%    5. Any violation/2 or violation/3 atoms in the answer set are reported
%
%    ARCHITECTURE - Input Facts (from json_to_asp.py)
%    ------------------------------------------------
%
%    character(ID).           - Characters who can act
%    object(ID).              - Objects that can be manipulated
%    location(ID).            - Places where events occur
%    event(ID).               - Discrete actions/events
%    event_type(E, Type).     - What kind of action (eat, move, take, etc.)
%    agent(E, A).             - Who performs the action
%    patient(E, P).           - What is acted upon
%    location(E, L).          - Where it happens
%    time(E, Start, End).     - When it happens (interval)
%    time_order(T1, T2).      - T1 comes before T2
%    holds(Fluent, S, E).     - Fluent is true during [S, E]
%    trait(C, T).             - Character C has trait T
%
%    Output Predicates (derived by rules)
%    ------------------------------------
%
%    violation(Type, E).      - Event E has a violation of Type
%    violation(Type, E1, E2). - Events E1, E2 together violate Type
%
%    RULE STRUCTURE
%    --------------
%
%    Rules in ASP have the form:
%        head :- body1, body2, ..., not negated_body.
%
%    This means: "head is true if body1 AND body2 AND ... AND NOT negated_body"
%
%    HOW TO READ ASP RULES
%    ---------------------
%
%    ASP uses Prolog-like syntax:
%
%        head :- body.
%
%    Means: "head is true IF body is true"
%
%    Example:
%        mortal(X) :- human(X).
%        "X is mortal if X is human"
%
%    Comma (,) means AND:
%        parent(X,Y) :- father(X,Y).
%        parent(X,Y) :- mother(X,Y).
%        grandparent(X,Z) :- parent(X,Y), parent(Y,Z).
%
%    "not" means negation-as-failure (cannot prove true):
%        innocent(X) :- suspect(X), not guilty(X).
%
%    The #show directives at the end control what appears in the output.
%    We only show violation atoms, which represent detected inconsistencies.
%
% =============================================================================

% =============================================================================
% PART 1: TEMPORAL REASONING
% =============================================================================
%
% Temporal reasoning is fundamental to narrative consistency. We need to:
% - Establish when events occur (time points and intervals)
% - Determine the ordering of time points
% - Detect overlapping events
% - Check that events respect temporal constraints
%
% The story provides time/3 facts for events:
%     time(EventId, StartTime, EndTime).
%
% And time_order/2 facts for sequencing:
%     time_order(T1, T2).  % means T1 comes before T2
%
% Key predicates derived:
%   - before(T1, T2): T1 is earlier than T2 (transitive)
%   - overlap(E1, E2): Events E1 and E2 happen at the same time
%   - precedes(E1, E2): E1 finishes before E2 starts
%   - concurrent(E1, E2): E1 and E2 overlap
%
% =============================================================================

% ----- Time Point Collection -----
% We need to know all time points that exist in the story. These come from
% event start/end times and fluent intervals.
%
% time_point(T) is true for any time point T mentioned in the story.

time_point(T) :- time(_,T,_).      % Start times of events
time_point(T) :- time(_,_,T).      % End times of events
time_point(T) :- holds(_,T,_).     % Start times of fluent intervals
time_point(T) :- holds(_,_,T).     % End times of fluent intervals

% ----- Temporal Ordering -----
% The before/2 relation is the transitive closure of time_order/2.
% If we know t1 < t2 and t2 < t3, we can derive t1 < t3.
%
% before(T1, T2) means T1 is strictly before T2 in the timeline.

before(T1,T2) :- time_order(T1,T2).                    % Direct ordering
before(T1,T3) :- before(T1,T2), before(T2,T3).        % Transitive closure

% ----- Event Temporal Relations -----
% These predicates help us reason about how events relate temporally.

% Two events OVERLAP if their time intervals intersect.
% Events [S1, End1] and [S2, End2] overlap when:
%   - End1 is NOT before S2 (E1 doesn't end before E2 starts), AND
%   - End2 is NOT before S1 (E2 doesn't end before E1 starts)
%
% Visual example of overlap:
%   E1: [====]
%   E2:   [====]
%         ^^-- overlap region
%
% They DON'T overlap if one ends before the other starts:
%   E1: [====]
%   E2:           [====]   (E1 ends before E2 starts, no overlap)

overlap(E1,E2) :-
    event(E1), event(E2),           % Both must be events
    time(E1,S1,End1),               % Get E1's interval
    time(E2,S2,End2),               % Get E2's interval
    not before(End1,S2),            % E1 doesn't end before E2 starts
    not before(End2,S1),            % E2 doesn't end before E1 starts
    E1 != E2.                       % Don't compare an event with itself

% Event E1 PRECEDES E2 if E1 ends before E2 starts.
% Visual:
%   E1: [====]
%   E2:        [====]
%              ^ E1 precedes E2

precedes(E1,E2) :-
    event(E1), event(E2),
    time(E1,_,End1),                % Get E1's end time
    time(E2,S2,_),                  % Get E2's start time
    before(End1,S2).                % E1 ends before E2 starts

% Event E1 MEETS E2 if E1 ends exactly when E2 starts (no gap, no overlap).
% Visual:
%   E1: [====]
%   E2:      [====]
%           ^ E1 meets E2

meets(E1,E2) :-
    event(E1), event(E2),
    time(E1,_,T),                   % E1 ends at time T
    time(E2,T,_),                   % E2 starts at time T
    E1 != E2.

% CONCURRENT is symmetric overlap (E1 overlaps E2 OR E2 overlaps E1)
concurrent(E1,E2) :- overlap(E1,E2).
concurrent(E1,E2) :- overlap(E2,E1).


% =============================================================================
% PART 2: FLUENT REASONING
% =============================================================================
%
% Fluents are properties that can change over time. Examples:
% - "The door is open" (can become closed)
% - "Alice is alive" (can become dead)
% - "Bob has the key" (can lose/give it)
%
% The story may provide explicit fluent intervals via holds/3:
%     holds(fluent(property, entity), StartTime, EndTime).
%
% Events can also cause fluents to become true or false via:
%     causes(EventType, Polarity, Property, Role).
% Where:
%     - EventType is the type of event (e.g., "open", "die")
%     - Polarity is "pos" (makes true) or "neg" (makes false)
%     - Property is the fluent property (e.g., "open", "alive")
%     - Role is which participant is affected ("agent", "patient")
%
% =============================================================================

% ----- Role Extraction -----
% Events have participants in different roles. We extract these for rule matching.
% Helper to get the entity filling a role in an event

role_arg(E, agent, A) :- agent(E,A).         % The doer of the action
role_arg(E, patient, P) :- patient(E,P).     % The receiver of the action
role_arg(E, instrument, I) :- instrument(E,I). % Tool used (if any)

% ----- Explicit Fluent Intervals -----
% A fluent holds at time T if T falls within its explicit interval [Start, End].
% The condition "not before(T,Start), not before(End,T)" means:
%   Start <= T <= End

holds_at(F,T) :- 
    holds(F,Start,End),             % Fluent F holds from Start to End
    time_point(T),                  % T is a valid time point
    not before(T,Start),            % T is not before Start (i.e., T >= Start)
    not before(End,T).              % End is not before T (i.e., T <= End)

% ----- Event Effects (Causality) -----
% When an event of a certain type occurs, it may cause a fluent to become true.
% For example: causes(open, pos, open, patient) means:
%   "An 'open' event makes the 'open' property true for the patient"

% Positive effect: event makes fluent true
holds_at(fluent(Pred,Arg),End) :-
    event(E), event_type(E,Type),   % E is an event of type Type
    causes(Type,pos,Pred,Role),     % Type causes positive fluent Pred for Role
    role_arg(E,Role,Arg),           % Arg is the entity in that role
    time(E,_,End).                  % The fluent becomes true at event end

% Negative effect: event makes fluent false
holds_at(neg_fluent(Pred,Arg),End) :-
    event(E), event_type(E,Type),
    causes(Type,neg,Pred,Role),     % Type causes NEGATIVE effect
    role_arg(E,Role,Arg),
    time(E,_,End).

% ----- Fluent Persistence (Frame Axiom) -----
% In the frame problem, we need to specify what DOESN'T change.
% "Things stay the same unless something changes them"
% A fluent established at T1 continues to hold at later times
% unless we have evidence it was negated.
%
% CAUTION: This can cause grounding issues with many time points.
% We use a simplified version that only propagates to known time points.

holds_at(F,T2) :- 
    holds_at(F,T1),                 % F holds at T1
    before(T1,T2),                  % T2 comes after T1
    time_point(T2),                 % T2 is a valid time point
    not holds_at_negated(F,T2).     % F is not negated at T2

% Check if a fluent is negated at a time
% A fluent is negated if there's an explicit neg_fluent
holds_at_negated(fluent(Pred,Arg),T) :- holds_at(neg_fluent(Pred,Arg),T).

% ----- Precondition Checking -----
% Some events require certain conditions to be true before they can occur.
% For example: precondition(wake, pos, asleep, agent) means:
%   "To wake, the agent must be asleep"
%
% precondition(EventType, pos/neg, FluentName, Role)

requires(E,Pol,Pred,Role) :-
    event_type(E,Type),             % E is an event of type Type
    precondition(Type,Pol,Pred,Role). % Type requires precondition

% VIOLATION: Positive precondition not met
% The event requires something to be TRUE, but it isn't
violation(precondition_not_met,E,Pred) :-
    event(E), 
    requires(E,pos,Pred,Role),      % E requires Pred to be true
    role_arg(E,Role,Arg),           % for entity Arg in role Role
    time(E,Start,_),                % at event start time
    not holds_at(fluent(Pred,Arg),Start). % but it's not true!

% VIOLATION: Negative precondition violated
% The event requires something to be FALSE, but it's true
violation(precondition_violated,E,Pred) :-
    event(E),
    requires(E,neg,Pred,Role),      % E requires Pred to be false
    role_arg(E,Role,Arg),
    time(E,Start,_),
    holds_at(fluent(Pred,Arg),Start). % but it IS true!


% =============================================================================
% PART 3: SPATIAL REASONING
% =============================================================================
%
% Characters have locations, and physical constraints apply:
% - A character cannot be in two places at the same time
% - Some actions require characters to be co-located
%
% Events provide location information via location/2:
%     location(EventId, LocationId).
%
% =============================================================================

% ----- Location at Event Time -----
% When a character is the agent of an event at a location, they're AT that location.

at_during(Entity,Loc,E) :- 
    event(E), 
    agent(E,Entity),                % Entity is doing the action
    location(E,Loc).                % at location Loc

% ----- Ubiquity Violation -----
% A character cannot be in two different places at the same time.
% This catches errors like "Alice was in the kitchen while also being in the garden."
%
% Example violation:
%   Event E1: Alice is in Paris at t1
%   Event E2: Alice is in London at t1
%   → violation(ubiquity, e1, e2)

violation(ubiquity,E1,E2) :-
    event(E1), event(E2),
    agent(E1,A), agent(E2,A),       % Same agent A in both events
    location(E1,L1), location(E2,L2),
    L1 != L2,                       % Different locations
    overlap(E1,E2).                 % Events happen at the same time


% =============================================================================
% PART 4: ATTENTION/FOCUS CONSTRAINTS
% =============================================================================
%
% Some actions require the agent's full attention (focus). A character cannot
% perform multiple focus-requiring actions simultaneously.
% You can't fight while reading, or cook while performing surgery.
%
% Events mark focus requirements with requires_focus/1:
%     requires_focus(EventId).
%
% =============================================================================

% VIOLATION: Focus Overlap
% Cannot do two focus-requiring tasks at the same time

violation(focus_overlap,E1,E2) :-
    event(E1), event(E2),
    requires_focus(E1),             % E1 requires focus
    requires_focus(E2),             % E2 requires focus
    agent(E1,A), agent(E2,A),       % Same agent
    overlap(E1,E2),                 % Events overlap
    E1 < E2.                        % Avoid duplicate reports (E1,E2) and (E2,E1)


% =============================================================================
% PART 5: WORLD KNOWLEDGE DEFAULTS
% =============================================================================
%
% This section encodes common-sense knowledge about the world that doesn't
% need to be explicitly stated in every story. Examples:
% - Rocks are not edible
% - Dead characters can't act
% - Fire requires fuel
%
% We use default reasoning with negation-as-failure:
%     edible(X) :- object(X), not non_edible(X).
% This means "X is edible if X is an object AND we can't prove X is non-edible"
%
% =============================================================================

% ----- Edibility -----
% We maintain lists of edible and non-edible categories.
% Objects are edible by default unless they're in a non-edible category.

% Things that are definitely NOT edible:
non_edible(X) :- rock(X).          % Rocks
non_edible(X) :- metal(X).         % Metal objects
non_edible(X) :- poison(X).        % Poison (technically ingestible but harmful)
non_edible(X) :- glass(X).         % Glass
non_edible(X) :- plastic(X).       % Plastic
non_edible(X) :- wood(X).          % Wood
non_edible(X) :- paper(X).         % Paper
non_edible(X) :- inedible(X).      % Explicitly marked inedible
non_edible(X) :- cottage(X).       % Houses/buildings (even if made of bread!)
non_edible(X) :- building(X).      % Buildings
non_edible(X) :- furniture(X).     % Furniture
non_edible(X) :- pebbles(X).       % Pebbles/small stones (important for Hansel & Gretel!)
non_edible(X) :- white_pebbles(X). % White pebbles
non_edible(X) :- stones(X).        % Stones

% Default: objects are edible unless proven otherwise
edible(X) :- object(X), not non_edible(X).

% Things that are definitely edible (override non_edible if both apply):
edible(X) :- food(X).              % Generic food
edible(X) :- fruit(X).             % Fruits
edible(X) :- vegetable(X).         % Vegetables
edible(X) :- meat(X).              % Meat
edible(X) :- bread(X).             % Bread (important for Hansel & Gretel!)
edible(X) :- cake(X).              % Cake
edible(X) :- candy(X).             % Candy
edible(X) :- crumbs(X).            % Crumbs (bread crumbs are edible)
edible(X) :- gingerbread(X).       % Gingerbread (the witch's house is edible!)
edible(X) :- sugar(X).             % Sugar

% VIOLATION: Eating non-edible objects
% Catches errors like "He ate a rock" or "She consumed the metal key"
%
% Example: "Hansel ate the pebbles" → violation(non_edible_food, e5)

violation(non_edible_food,E) :-
    event(E), 
    event_type(E,eat),              % It's an eating event
    patient(E,X),                   % X is what's being eaten
    not edible(X).                  % X is not edible

% ----- Living/Dead State -----
% Characters who die cannot perform actions after death.
% Death can occur through "die" events (agent dies) or "kill" events (patient dies).
% Death is irreversible (in typical narratives).

% Track when characters become dead
dead_after(C,T) :- event(E), event_type(E,die), agent(E,C), time(E,_,T).
dead_after(C,T) :- event(E), event_type(E,kill), patient(E,C), time(E,_,T).

% VIOLATION: Dead characters acting
% Catches errors like "After the knight was slain, he rode into battle"
%
% Example:
%   e1: Alice dies at t1
%   e2: Alice walks at t2 (where t1 < t2)
%   → violation(dead_agent, e2)

violation(dead_agent,E) :-
    event(E),
    agent(E,C),                     % C performs action E
    time(E,Tstart,_),               % E starts at Tstart
    dead_after(C,Tdeath),           % C died at Tdeath
    before(Tdeath,Tstart).          % Tdeath is before Tstart (action after death!)


% =============================================================================
% PART 6: CHARACTER TRAIT CONSTRAINTS
% =============================================================================
%
% Characters may have traits that constrain their behavior. For example:
% - A claustrophobic character shouldn't willingly enter small spaces
% - A blind character cannot read or see
%
% Traits are provided via trait/2:
%     trait(CharacterId, TraitName).
%
% =============================================================================

% ----- Trait Normalization -----
% LLMs may generate trait names in different forms (noun vs adjective).
% We normalize to handle common variations.
trait(A, claustrophobic) :- trait(A, claustrophobia).
trait(A, aquaphobic) :- trait(A, aquaphobia).
trait(A, acrophobic) :- trait(A, acrophobia).
trait(A, blind) :- trait(A, blind_from_birth).
trait(A, deaf) :- trait(A, deaf_from_birth).
trait(A, mute) :- trait(A, mute_from_birth).

% ----- Phobias -----

% CLAUSTROPHOBIA: Fear of enclosed spaces
violation(claustrophobia,E) :-
    trait(A, claustrophobic),       % A has claustrophobia
    event(E), agent(E,A),           % A is doing something
    event_type(E, enter),           % specifically, entering
    location(E, L),                 % a location L
    enclosed_space(L).              % that is enclosed

% Known enclosed spaces:
enclosed_space(elevator).
enclosed_space(closet).
enclosed_space(cave).
enclosed_space(tunnel).

% ACROPHOBIA: Fear of heights
violation(acrophobia,E) :-
    trait(A, acrophobic),           % A fears heights
    event(E), agent(E,A),           % A is doing something
    location(E, L),                 % at location L
    high_place(L).                  % that is high up

% Known high places:
high_place(cliff).
high_place(tower).
high_place(rooftop).
high_place(mountain_peak).

% AQUAPHOBIA: Fear of water
violation(aquaphobia,E) :-
    trait(A, aquaphobic),
    event(E), agent(E,A),
    event_type(E, swim).            % Swimming requires being in water

violation(aquaphobia,E) :-
    trait(A, aquaphobic),
    event(E), agent(E,A),
    location(E, L),
    water_location(L).              % Being at a water location

% Known water locations:
water_location(ocean).
water_location(sea).
water_location(lake).
water_location(river).
water_location(pool).

% ----- Physical Limitations -----

% BLINDNESS: Cannot perform actions requiring sight
violation(physical_impossibility,E) :-
    trait(A, blind),
    event(E), agent(E,A),
    event_type(E, Type),
    requires_sight(Type).

% Actions requiring sight:
requires_sight(read).
requires_sight(read_blueprints).
requires_sight(watch).
requires_sight(see).
requires_sight(observe).
requires_sight(look).

% DEAFNESS: Cannot perform actions requiring hearing
violation(physical_impossibility,E) :-
    trait(A, deaf),
    event(E), agent(E,A),
    event_type(E, Type),
    requires_hearing(Type).

% Actions requiring hearing:
requires_hearing(hear).
requires_hearing(listen).
requires_hearing(eavesdrop).

% MUTENESS: Cannot perform actions requiring speech
violation(physical_impossibility,E) :-
    trait(A, mute),
    event(E), agent(E,A),
    event_type(E, Type),
    requires_speech(Type).

% Actions requiring speech:
requires_speech(speak).
requires_speech(shout).
requires_speech(shout_instructions).
requires_speech(sing).
requires_speech(call).
requires_speech(call_police).
requires_speech(yell).
requires_speech(scream).


% =============================================================================
% PART 7: POSSESSION CONSTRAINTS
% =============================================================================
%
% Characters can acquire and lose objects. Some actions require possessing
% certain objects (e.g., you can't give away something you don't have).
%
% This is a simplified model that tracks acquisition but not loss.
%
% =============================================================================

% Track possession via take/get/receive events
% has_after(Agent, Object, T) means Agent possesses Object after time T

has_after(Agent,Object,T) :-
    event(E), event_type(E,take), 
    agent(E,Agent), patient(E,Object),
    time(E,_,T).

has_after(Agent,Object,T) :-
    event(E), event_type(E,get), 
    agent(E,Agent), patient(E,Object),
    time(E,_,T).

has_after(Agent,Object,T) :-
    event(E), event_type(E,receive), 
    agent(E,Agent), patient(E,Object),
    time(E,_,T).

% NOTE: We don't currently check for possession violations because they
% require more complex reasoning about initial possession and transfers.
% Future work could add rules like:
%
% violation(not_possessed,E) :-
%     event(E), event_type(E,give),
%     agent(E,A), patient(E,O),
%     time(E,T,_),
%     not has_before(A,O,T).


% =============================================================================
% PART 8: COMMON PRECONDITIONS AND EFFECTS
% =============================================================================
%
% This section defines common-sense rules about what actions require and
% what effects they have. These are generic rules that apply across stories.
%
% Format:
%     causes(EventType, Polarity, Property, Role).
%     precondition(EventType, Polarity, Property, Role).
%
% =============================================================================

% ----- State Change Effects -----

% Opening/closing:
causes(open,pos,open,patient).     % "open door" -> door is open
causes(close,neg,open,patient).    % "close door" -> door is NOT open

% Locking/unlocking:
causes(lock,pos,locked,patient).   % "lock door" -> door is locked
causes(unlock,neg,locked,patient). % "unlock door" -> door is NOT locked

% Breaking/fixing:
causes(break,pos,broken,patient).  % "break vase" -> vase is broken
causes(fix,neg,broken,patient).    % "fix vase" -> vase is NOT broken
causes(repair,neg,broken,patient). % "repair vase" -> vase is NOT broken

% ----- Sleep/Wake -----
% These demonstrate preconditions: you must be asleep to wake up

causes(sleep,pos,asleep,agent).    % "sleep" -> agent is asleep
causes(wake,neg,asleep,agent).     % "wake" -> agent is NOT asleep
precondition(wake,pos,asleep,agent). % To wake, must BE asleep first


% =============================================================================
% PART 9: OUTPUT CONFIGURATION
% =============================================================================
%
% The #show directives control what atoms appear in the output.
% We only want to see violations, not all the derived facts.
%
% =============================================================================

% Show all violations with 2 arguments: violation(Type, Event)
#show violation/2.

% Show all violations with 3 arguments: violation(Type, Event, Detail)
#show violation/3.


% =============================================================================
%
%    END OF RULES FILE
%
%    To test this file:
%    $ clingo rules/base.lp facts.lp
%
%    To see all derived atoms (for debugging):
%    $ clingo rules/base.lp facts.lp --show-all
%
% =============================================================================
