{
  "version": "1.0.0",
  "description": "Generic, story-agnostic world-knowledge predicates used only to VERIFY existing candidates (never to generate new ones). Every key/value here is a generic class or relation (container, support_surface, portable, material, state, action, relationship_type) -- never a character/story/chapter-specific name.",
  "containment": {
    "container_types": ["room", "house", "building", "box", "bag", "vehicle", "cave", "castle", "chest", "pocket"],
    "support_surface_types": ["table", "floor", "ground", "chair", "shelf", "bed", "wall"]
  },
  "affordances": {
    "requires_possession": ["give", "drop", "use", "throw", "wield", "read", "eat", "drink", "wear", "open", "break", "hand_over"],
    "requires_support_surface": ["sit", "lie", "place", "put_down", "rest"],
    "requires_sight": ["read", "see", "watch", "observe", "look", "aim"],
    "requires_hearing": ["hear", "listen", "eavesdrop"],
    "requires_speech": ["speak", "shout", "sing", "call", "yell", "tell", "say"]
  },
  "material_properties": {
    "non_edible_materials": ["metal", "glass", "plastic", "wood", "stone", "paper", "rock"],
    "edible_materials": ["food", "fruit", "vegetable", "meat", "bread"],
    "flammable_materials": ["wood", "paper", "cloth", "oil"],
    "non_flammable_materials": ["metal", "stone", "glass", "water"]
  },
  "state_incompatibility": {
    "mutually_exclusive_states": [
      ["dead", "alive"],
      ["dead", "normal"],
      ["dead", "injured"],
      ["dead", "unconscious"],
      ["asleep", "awake"],
      ["visible", "invisible"]
    ]
  },
  "trait_action_incompatibility": {
    "blind": ["requires_sight"],
    "deaf": ["requires_hearing"],
    "mute": ["requires_speech"]
  },
  "emotional_action_compatibility": {
    "positive_relationship_types": ["loves", "likes", "trusts", "respects", "friendly", "ally", "friend", "family"],
    "negative_relationship_types": ["hates", "dislikes", "distrusts", "fears", "hostile", "enemy", "rival"],
    "actions_incompatible_with_positive": ["attack", "hit", "hurt", "betray", "abandon", "insult", "curse", "threaten", "kill", "murder"],
    "actions_incompatible_with_negative": ["hug", "kiss", "gift", "praise", "comfort", "farewell", "congratulate", "embrace", "welcome"]
  }
}
